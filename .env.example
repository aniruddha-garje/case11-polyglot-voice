# ============================================================
# Case 11: Polyglot Voice Companion — Environment Variables
# Copy this file to .env and edit as needed.
# NO API KEYS REQUIRED — everything runs locally.
# ============================================================

# Ollama endpoint (must be running: `ollama serve`)
OLLAMA_BASE_URL=http://localhost:11434/v1

# faster-whisper model size: tiny | base | small | medium
# tiny  = fastest (~80ms on CPU), lower accuracy on short Hindi phrases
# small = better accuracy, ~3x slower
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Piper voice names (must match downloaded .onnx file names in voices/)
PIPER_EN_VOICE=en_US-lessac-medium
PIPER_ES_VOICE=es_ES-carlfm-x_low

# Hindi TTS backend: xtts-v2 | pyttsx3
# xtts-v2  = better quality, slow on CPU (~5-10s per sentence)
# pyttsx3  = uses Windows SAPI, fast, quality depends on installed voices
TTS_HINDI_BACKEND=xtts-v2

# Logging level: DEBUG | INFO | WARNING
LOG_LEVEL=INFO

# LiveKit credentials — required even in console mode (values are not used for actual connection)
# unregistered=True in console mode skips the actual WebSocket handshake,
# but the worker still validates that these are non-empty.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
